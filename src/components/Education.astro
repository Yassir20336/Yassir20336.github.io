---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import Timeline from "./Timeline.astro";

const items = (siteConfig.education ?? []).map((e) => ({
  title: e.degree,
  subtitle: e.school,
  dateRange: e.dateRange,
  bullets: e.achievements,
}));
---

{items.length > 0 && (
  <section id="education" class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/30">
    <div class="section">
      <SectionHeading eyebrow="learning" title="Education & Certifications" />
      <div class="ml-4 max-w-4xl">
        <Timeline items={items} icon="school" />
      </div>
    </div>
  </section>
)}
