---
import Icon from "./Icon.astro";

interface Item {
  title: string;
  subtitle: string;
  dateRange: string;
  bullets: string[];
}
interface Props {
  items: Item[];
  icon: "briefcase" | "school";
}
const { items, icon } = Astro.props;
---

<ol class="relative space-y-8 border-l border-slate-200 pl-8 sm:pl-10 dark:border-slate-800">
  {items.map((item) => (
    <li class="reveal relative">
      <span class="absolute -left-[3.05rem] top-5 grid h-9 w-9 place-items-center rounded-full border border-slate-200 bg-white text-accent sm:-left-[3.55rem] dark:border-slate-700 dark:bg-slate-900 dark:text-blue-400">
        <Icon name={icon} class="h-4 w-4" />
      </span>
      <div class="card hover:border-slate-300 hover:shadow-lg dark:hover:border-slate-700">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{item.title}</h3>
            <p class="font-medium text-accent dark:text-blue-400">{item.subtitle}</p>
          </div>
          <span class="shrink-0 font-mono text-sm text-slate-500 dark:text-slate-400">{item.dateRange}</span>
        </div>
        <ul class="mt-4 space-y-2">
          {item.bullets.map((b) => (
            <li class="flex gap-3 leading-7">
              <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/60"></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>
