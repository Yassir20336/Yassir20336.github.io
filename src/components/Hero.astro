---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
import Socials from "./Socials.astro";
---

<section id="top" class="relative isolate overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-24">
  <!-- Background: soft accent glow + grid -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full bg-gradient-to-tr from-blue-400/30 via-indigo-400/20 to-cyan-300/20 blur-3xl dark:from-blue-600/25 dark:via-indigo-600/15 dark:to-cyan-500/10"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgb(148_163_184/0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgb(148_163_184/0.12)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      {siteConfig.availability && (
      <p class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-400">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75 motion-reduce:hidden"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        {siteConfig.availability}
      </p>
      )}

      <h1 class="mt-6 first:mt-0 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl lg:text-7xl dark:text-white">
        {siteConfig.name.replace(/-/g, "‑")}
      </h1>
      <p class="mt-4 text-xl font-semibold sm:text-2xl">
        <span class="bg-gradient-to-r from-blue-600 to-indigo-500 bg-clip-text text-transparent dark:from-blue-400 dark:to-indigo-300">
          {siteConfig.title}
        </span>
      </p>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-400">
        {siteConfig.description}
      </p>

      {siteConfig.location && (
        <p class="mt-4 flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400">
          <Icon name="pin" class="h-4 w-4" /> {siteConfig.location}
        </p>
      )}

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">
          Get in touch <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/resume.pdf" target="_blank" rel="noopener" class="btn btn-ghost">
          <Icon name="download" class="h-4 w-4" /> Download Resume
        </a>
        <Socials class="sm:ml-2" />
      </div>
    </div>

    {siteConfig.stats?.length > 0 && (
      <dl class="mt-16 grid max-w-3xl grid-cols-3 gap-4 border-t border-slate-200 pt-8 dark:border-slate-800">
        {siteConfig.stats.map((s) => (
          <div>
            <dt class="text-xs text-slate-500 sm:text-sm dark:text-slate-400">{s.label}</dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">{s.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
