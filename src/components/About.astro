---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const paragraphs = siteConfig.aboutMe
  .trim()
  .split(/\n\s*\n/)
  .map((p) => p.trim());
---

<section id="about" class="section">
  <SectionHeading eyebrow="about" title="About Me" />
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="reveal space-y-5 text-lg leading-8 lg:col-span-7">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="reveal lg:col-span-5">
      <div class="card">
        <h3 class="font-mono text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Skills & tools</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {siteConfig.skills.map((skill) => <li class="chip">{skill}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
