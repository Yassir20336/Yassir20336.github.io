---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
---

<section id="contact" class="section">
  <div class="reveal relative isolate overflow-hidden rounded-3xl bg-slate-900 px-6 py-14 text-center sm:px-12 sm:py-20 dark:bg-slate-900 dark:ring-1 dark:ring-slate-800">
    <div aria-hidden="true" class="absolute -top-24 left-1/2 -z-10 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-blue-600/30 blur-3xl"></div>
    <p class="font-mono text-sm text-blue-400">// contact</p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Let's build your next ERP solution</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">
      Need custom Odoo modules, an integration, a version migration or a full implementation? I'd be happy to talk.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={`mailto:${siteConfig.social.email}`} class="btn btn-primary">
        <Icon name="mail" class="h-4 w-4" /> {siteConfig.social.email}
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn border border-slate-700 text-white hover:bg-slate-800">
        <Icon name="linkedin" class="h-4 w-4" /> Connect on LinkedIn
      </a>
    </div>
  </div>
</section>
