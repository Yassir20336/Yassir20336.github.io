---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

type Project = (typeof siteConfig.projects)[number] & { link?: string };
const projects = siteConfig.projects as Project[];
---

{projects?.length > 0 && (
  <section id="projects" class="border-y border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/30">
    <div class="section">
      <SectionHeading eyebrow="work" title="Featured Projects" />
      <div class="grid gap-6 md:grid-cols-2">
        {projects.map((project, index) => {
          const Tag = project.link ? "a" : "article";
          const linkProps = project.link ? { href: project.link, target: "_blank", rel: "noopener noreferrer" } : {};
          return (
            <Tag
              {...linkProps}
              class="reveal card group flex flex-col hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-600/5 dark:hover:border-blue-800"
            >
              <div class="flex items-start justify-between">
                <span class="grid h-11 w-11 place-items-center rounded-xl bg-accent-soft text-accent dark:bg-blue-950 dark:text-blue-400">
                  <Icon name="code" />
                </span>
                <span class="font-mono text-sm text-slate-400">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">
                {project.name}
                {project.link && <Icon name="arrow" class="ml-1 inline h-4 w-4 -rotate-45 transition group-hover:translate-x-0.5" />}
              </h3>
              <p class="mt-3 flex-1 leading-7 text-slate-600 dark:text-slate-400">{project.description}</p>
              {project.skills?.length > 0 && (
                <ul class="mt-6 flex flex-wrap gap-2">
                  {project.skills.map((skill) => (
                    <li class="rounded-md bg-slate-900 px-2.5 py-1 font-mono text-xs text-white dark:bg-slate-800 dark:text-slate-200">{skill}</li>
                  ))}
                </ul>
              )}
            </Tag>
          );
        })}
      </div>
    </div>
  </section>
)}
