---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const s = siteConfig.social;
const items = [
  s.email && { href: `mailto:${s.email}`, label: "Email", icon: "mail" },
  s.linkedin && { href: s.linkedin, label: "LinkedIn", icon: "linkedin" },
  s.github && { href: s.github, label: "GitHub", icon: "github" },
  s.twitter && { href: s.twitter, label: "X (Twitter)", icon: "x" },
].filter(Boolean) as { href: string; label: string; icon: "mail" | "linkedin" | "github" | "x" }[];
---

<div class={`flex items-center gap-2 ${className}`}>
  {items.map((i) => (
    <a
      href={i.href}
      aria-label={i.label}
      title={i.label}
      {...(i.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      class="grid h-10 w-10 place-items-center rounded-lg border border-slate-200 text-slate-600 transition hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-400 dark:hover:border-blue-400 dark:hover:text-blue-400"
    >
      <Icon name={i.icon} />
    </a>
  ))}
</div>
